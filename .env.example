# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=your_postgres_password

# Redis Configuration (Auxiliary fast-path / rate limiting / idempotency)
REDIS_HOST=localhost
REDIS_PORT=6380

# Backend Server Configuration
SERVER_PORT=8085
SPRING_PROFILES_ACTIVE=

# Frontend Integration
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8085

# Google OAuth2 Authentication (Optional for automated tests; mock users provided)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Administrative Privileges (Comma-separated admin email list)
LEDGER_ADMIN_EMAILS=admin@ledger.com

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_FINANCIAL_MAX_ATTEMPTS=100
RATE_LIMIT_FINANCIAL_WINDOW_SECONDS=60
